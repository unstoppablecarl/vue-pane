{
  "name": "vue-pane",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/vue-pane.umd.cjs",
  "module": "./dist/vue-pane.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/vue-pane.js",
      "require": "./dist/vue-pane.umd.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "build:watch": "vite build --watch",
    "dev": "pnpm --prefix example dev",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "sass": "^1.77.8",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.12",
    "vite-plugin-dts": "^5.0.2",
    "vue": "^3.5.34",
    "vue-tsc": "^3.2.8"
  },
  "author": {
    "name": "Carl Olsen",
    "email": "unstoppablecarlolsen@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unstoppablecarl/vue-pane.git"
  },
  "bugs": {
    "url": "https://github.com/unstoppablecarl/vue-pane/issues"
  }
}
